#!/bin/sh

# 1. 基础网络调优与封包防乱序（禁用 packet_steering 配置与服务以防重载时覆盖 Wi-Fi 四核绑核并确保多核 UDP 保序，显式禁用网桥 igmp_snooping 确保开机原生放行 IPv6 NDP 邻居发现与 IPTV 组播）
uci -q batch <<EOF
set network.globals.packet_steering='0'
set network.@device[0].igmp_snooping='0'
set network.wan.sourcefilter='0'
commit network
EOF
if [ -f /etc/init.d/packet_steering ]; then
    /etc/init.d/packet_steering disable 2>/dev/null || true
    /etc/init.d/packet_steering stop 2>/dev/null || true
fi

# 1.1 开启 Firewall4 软件流卸载并保持关闭硬件 PPE 流卸载（启用内核 flowtable 加速网桥与路由；关闭 PPE 硬件流表以根除 AN7581 PPE 驱动在 IPv6 PPPoE 下丢包导致阿里 CDN / 夸克 App / 网盘卡顿的问题），补全 wan_6 动态接口
uci -q batch <<EOF
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='0'
add_list firewall.@zone[1].network='wan_6'
commit firewall
EOF


# 1.2 预置 LuCI 默认主题为 Vantage 主题（并注册主题列表）
uci -q batch <<EOF
set luci.themes.Vantage='/luci-static/vantage'
set luci.main.mediaurlbase='/luci-static/vantage'
commit luci
EOF



# 1.3 预置单线复用异 VLAN IPTV 桥接与端口隔离 (pon0.45 IGMP 上行 + pon0.50 组播下行，原生 bridge-port isolate='1' 防止环路反射)
if [ -z "$(uci -q get network.iptv)" ]; then
    uci -q batch <<EOF
set network.pon0_45=bridge-port
set network.pon0_45.device='pon0.45'
set network.pon0_45.isolate='1'

set network.pon0_50=bridge-port
set network.pon0_50.device='pon0.50'
set network.pon0_50.isolate='1'
set network.pon0_50.learning='0'

set network.br_iptv=device
set network.br_iptv.name='br-iptv'
set network.br_iptv.type='bridge'
set network.br_iptv.igmp_snooping='0'
add_list network.br_iptv.ports='pon0.45'
add_list network.br_iptv.ports='pon0.50'

set network.iptv=interface
set network.iptv.proto='static'
set network.iptv.device='br-iptv'
set network.iptv.ipaddr='169.254.50.2'
set network.iptv.netmask='255.255.255.0'
set network.iptv.defaultroute='0'
set network.iptv.peerdns='0'
set network.iptv.delegate='0'
commit network
EOF
fi

if [ -z "$(uci -q get firewall.iptv)" ]; then
    uci -q batch <<EOF
set firewall.iptv=zone
set firewall.iptv.name='iptv'
set firewall.iptv.input='DROP'
set firewall.iptv.output='ACCEPT'
set firewall.iptv.forward='DROP'
add_list firewall.iptv.network='iptv'

set firewall.allow_iptv_igmp=rule
set firewall.allow_iptv_igmp.name='Allow-IPTV-IGMP'
set firewall.allow_iptv_igmp.src='iptv'
set firewall.allow_iptv_igmp.proto='igmp'
set firewall.allow_iptv_igmp.target='ACCEPT'

set firewall.allow_iptv_mcast=rule
set firewall.allow_iptv_mcast.name='Allow-IPTV-Multicast'
set firewall.allow_iptv_mcast.src='iptv'
set firewall.allow_iptv_mcast.proto='udp'
set firewall.allow_iptv_mcast.dest_ip='224.0.0.0/4'
set firewall.allow_iptv_mcast.target='ACCEPT'
commit firewall
EOF
fi

# 2. 预置 rtp2httpd 高性能组播/RTSP/FCC 代理参数 (接管 port 4022，绑定 br-iptv，兼容 /www/iptv.m3u 与 udpxy 路径格式)
# 注意：使用 instance 结构与纯端口号 '4022' 监听 IPv4/IPv6，确保开机自启并修复 LuCI 状态/播放器按钮跳转
if [ -f /etc/config/rtp2httpd ]; then
    uci -q delete rtp2httpd.@rtp2httpd[0]
    uci -q delete rtp2httpd.@instance[0]
    uci -q batch << 'EOF'
set rtp2httpd.main=instance
set rtp2httpd.main.enabled='1'
del rtp2httpd.main.listen
add_list rtp2httpd.main.listen='4022'
set rtp2httpd.main.upstream_interface='br-iptv'
set rtp2httpd.main.noudpxy='0'
set rtp2httpd.main.workers='4'
set rtp2httpd.main.maxclients='20'
set rtp2httpd.main.buffer_pool_max_size='16384'
set rtp2httpd.main.udp_rcvbuf_size='2097152'
set rtp2httpd.main.external_m3u='file:///www/iptv.m3u'
commit rtp2httpd
EOF
fi

if [ -f /etc/config/msd_lite ]; then
    uci -q set msd_lite.@instance[0].enabled='0'
    uci -q commit msd_lite
fi

if [ -f /etc/config/udpxy ]; then
    uci -q set udpxy.@udpxy[0].disabled='1'
    uci -q commit udpxy
fi


# 3. 禁用系统自带独立 sing-box 服务自启（由 momo 独占调度管理，彻底杜绝双进程冲突与端口争抢）
if [ -f /etc/init.d/sing-box ]; then
    /etc/init.d/sing-box disable 2>/dev/null
    /etc/init.d/sing-box stop 2>/dev/null
fi
rm -f /etc/rc.d/S*sing-box 2>/dev/null

# 3.1 预置 Firewall4 对 Momo (tun0) 的放行与转发表（彻底杜绝 DNS 劫持丢包与转发拒绝，确保直连与内网分流无缝打通）
if [ -z "$(uci -q get firewall.momo)" ]; then
    uci -q batch << 'EOF'
set firewall.momo=zone
set firewall.momo.name='momo'
set firewall.momo.input='ACCEPT'
set firewall.momo.output='ACCEPT'
set firewall.momo.forward='ACCEPT'
add_list firewall.momo.device='tun0'

set firewall.lan_momo=forwarding
set firewall.lan_momo.src='lan'
set firewall.lan_momo.dest='momo'

set firewall.momo_lan=forwarding
set firewall.momo_lan.src='momo'
set firewall.momo_lan.dest='lan'

set firewall.momo_wan=forwarding
set firewall.momo_wan.src='momo'
set firewall.momo_wan.dest='wan'
commit firewall
EOF
fi

# 4. 预置 momo 纯核心模式（分流与旁路规则完全遵循 sing-box 订阅与原生 auto_redirect）、默认优先远程配置 (prefer='remote')、128MiB 健康堆内存上限（适配 512MB RAM）、定时重启与日志自动清理
if [ -f /etc/config/momo ]; then
    uci -q batch <<EOF
set momo.config.core_only='1'
set momo.procd.env_go_mem_limit='128MiB'
set momo.log.scheduled_clear='1'
set momo.log.scheduled_clear_size_limit='1'
set momo.log.scheduled_clear_size_limit_unit='MB'
set momo.log.scheduled_clear_cron='0 * * * *'
set momo.config.scheduled_restart='0'
set momo.config.scheduled_restart_cron='0 4 * * *'
commit momo
EOF
    for sub in $(uci -q show momo | grep '=subscription' | cut -d. -f2 | cut -d= -f1); do
        uci -q set momo.${sub}.prefer='remote'
    done
    uci -q commit momo
fi
if [ -f /etc/init.d/momo ]; then
    /etc/init.d/momo enable 2>/dev/null || true
fi
mkdir -p /etc/momo/profiles

# 确保热插拔与系统调优脚本拥有执行权限
chmod +x /etc/hotplug.d/net/99-multicast 2>/dev/null || true
chmod +x /etc/hotplug.d/net/99-wifi-affinity 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/90-ipv6-fix 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/95-iptv-m3u-ip 2>/dev/null || true
chmod +x /usr/sbin/pin-wifi-cpus.sh 2>/dev/null || true

# 首次启动时自动将 /www/iptv.m3u 中的播放地址同步为当前 LAN IP
LAN_IP=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
if [ -n "$LAN_IP" ] && [ -f /www/iptv.m3u ]; then
    sed -i -E "s|http://[0-9.]+(/[0-9]+)?:4022/rtp/|http://${LAN_IP}:4022/rtp/|g" /www/iptv.m3u 2>/dev/null
fi

# 5. 优化开机 rc.local：高通量 IPTV UDP 核心参数、网卡队列深度与有线网口组播直通
cat << 'RCLOCAL' > /etc/rc.local
# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# 1. 仅当非 PPPoE 主路由（如作为纯旁路由）且缺失默认路由时才回退 fe80::1
if [ "$(uci -q get network.wan.proto)" != "pppoe" ] && [ ! -d /sys/class/net/pppoe-wan ]; then
    if ! ip -6 route show default 2>/dev/null | grep -q 'default'; then
        ip -6 route replace default via fe80::1 dev br-lan 2>/dev/null
    fi
fi

# 2. 重新加载高通量网络缓冲与 IPTV UDP 核心参数
sysctl -p /etc/sysctl.d/99-custom-net-optimization.conf 2>/dev/null

# 3. 提升核心网桥与网口队列深度为 5000，消除突发高码流丢包
ip link set br-lan txqueuelen 5000 2>/dev/null
for dev in lan1 lan2 lan3 lan4 eth1 pon0; do
    ip link set "$dev" txqueuelen 5000 2>/dev/null
done

# 4. 组播侦听与查询优化，保持网桥组播直通（放行 LLDP 0x4000 避免下挂 AP 组播心跳产生 rx_dropped，避免 snooping 拦截 IPv6 NDP 邻居发现与 IPTV 组播）
echo 0x4000 > /sys/devices/virtual/net/br-lan/bridge/group_fwd_mask 2>/dev/null
echo 0 > /sys/devices/virtual/net/br-lan/bridge/multicast_snooping 2>/dev/null
for eth_port in /sys/devices/virtual/net/br-lan/brif/lan* /sys/devices/virtual/net/br-lan/brif/eth* /sys/devices/virtual/net/br-lan/brif/pon*; do
    [ -d "$eth_port" ] && echo 2 > "$eth_port/multicast_router" 2>/dev/null
done

# 5. 绑定以太网硬中断与 Wi-Fi 四核收发线程亲和性（IRQ 17->CPU1, IRQ 21->CPU2；mt76-tx->CPU3，napi/phy0-0 打散至 CPU0/1/2）
echo 1 > /proc/irq/17/smp_affinity_list 2>/dev/null
echo 2 > /proc/irq/21/smp_affinity_list 2>/dev/null
[ -x /usr/sbin/pin-wifi-cpus.sh ] && /usr/sbin/pin-wifi-cpus.sh

# 6. 精细化 CPUFreq ondemand / conservative 功耗与温控调度
# ondemand: 75%门限、驻留倍数1立即回落、10%节电偏置激活中间频阶、忽略低优后台负载
if [ -d /sys/devices/system/cpu/cpufreq/ondemand ]; then
    echo 75 > /sys/devices/system/cpu/cpufreq/ondemand/up_threshold 2>/dev/null
    echo 1 > /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor 2>/dev/null
    echo 100 > /sys/devices/system/cpu/cpufreq/ondemand/powersave_bias 2>/dev/null
    echo 1 > /sys/devices/system/cpu/cpufreq/ondemand/ignore_nice_load 2>/dev/null
    echo 0 > /sys/devices/system/cpu/cpufreq/ondemand/io_is_busy 2>/dev/null
fi
# conservative: 10%快速阶跃(消除爬频顿挫)、70%升频门限、30%降频门限、倍数2平滑过渡、忽略低优负载
if [ -d /sys/devices/system/cpu/cpufreq/conservative ]; then
    echo 10 > /sys/devices/system/cpu/cpufreq/conservative/freq_step 2>/dev/null
    echo 70 > /sys/devices/system/cpu/cpufreq/conservative/up_threshold 2>/dev/null
    echo 30 > /sys/devices/system/cpu/cpufreq/conservative/down_threshold 2>/dev/null
    echo 2 > /sys/devices/system/cpu/cpufreq/conservative/sampling_down_factor 2>/dev/null
    echo 1 > /sys/devices/system/cpu/cpufreq/conservative/ignore_nice_load 2>/dev/null
fi

# 7. 调优 PPE 流表硬件加速触发门限（降至 5 pps，加速常规数据流流表直转，彻底释放 CPU CDM1 队列拥塞）
if [ -w /sys/kernel/debug/ppe/bind_rate ]; then
    echo "5 5" > /sys/kernel/debug/ppe/bind_rate 2>/dev/null
fi

exit 0
RCLOCAL

# 6. ZRAM 内存压缩扩容调优 (zstd 高压缩比算法 + 256MB 稀疏压缩交换区，适配 512MB RAM)
uci set system.@system[0].zram_size_mb='256'
uci set system.@system[0].zram_comp_algo='zstd'
uci commit system

# 7. 每日凌晨 04:30 自动执行 ZRAM 内存空洞压缩整理（紧跟 04:00 momo 定时重启之后）
mkdir -p /etc/crontabs
(crontab -l 2>/dev/null | grep -v 'compact'; echo "30 4 * * * echo 1 > /sys/block/zram0/compact 2>/dev/null") | crontab -

# 8. QWRT 经典性能调优：iperf3 测速绑定 Core 3、wget 证书防抖、dnsmasq 降噪
sed -i '/iperf3=/d' /etc/profile 2>/dev/null
echo "alias iperf3='iperf3 -A 3'" >> /etc/profile
echo 'hsts=0' > /root/.wgetrc
sed -i '/log-facility/d' /etc/dnsmasq.conf 2>/dev/null
echo "log-facility=/dev/null" >> /etc/dnsmasq.conf

# 9. 烽火 (FiberHome) PON 认证与 Momo 自启配置跨版本升级自动保护机制
# 将关键路径加入 /etc/sysupgrade.conf，防止固件升级抹除认证数据与开机自启
SYSUPGRADE_CONF="/etc/sysupgrade.conf"
for path in "/etc/config/pon" "/etc/fiberhome_pon_backup.uci" "/etc/fiberhome_pon_info.txt" "/usr/sbin/backup-fiberhome-pon.sh" "/usr/sbin/restore-fiberhome-pon.sh" "/etc/rc.d/S99momo" "/etc/rc.d/K10momo"; do
    if ! grep -q "^$path" "$SYSUPGRADE_CONF" 2>/dev/null; then
        echo "$path" >> "$SYSUPGRADE_CONF"
    fi
done

# 若存在有效烽火配置，自动生成安全备份；若配置丢失则尝试从备份自动还原
if [ -x /usr/sbin/backup-fiberhome-pon.sh ] && [ -f /etc/config/pon ]; then
    /usr/sbin/backup-fiberhome-pon.sh 2>/dev/null || true
elif [ -x /usr/sbin/restore-fiberhome-pon.sh ] && [ ! -s /etc/config/pon ] && [ -f /etc/fiberhome_pon_backup.uci ]; then
    /usr/sbin/restore-fiberhome-pon.sh 2>/dev/null || true
fi

# 10. CPU 睿频动态调度与轻量化内存释放
# 默认采用精细化调优的 conservative 调度器（阶跃 10%、门限 70%/30%、低温平滑），空闲 500MHz，重载 1.2GHz
if [ -f /etc/config/cpufreq ]; then
    uci -q batch <<EOF
set cpufreq.cpufreq=settings
set cpufreq.cpufreq.governor0='conservative'
set cpufreq.cpufreq.minfreq0='500000'
set cpufreq.cpufreq.maxfreq0='1200000'
set cpufreq.cpufreq.sdfactor0='2'
set cpufreq.cpufreq.upthreshold0='70'
set cpufreq.global=settings
set cpufreq.global.set='1'
commit cpufreq
EOF
fi

# 默认关闭纯光猫网关未使用的 Samba4 与 wsdd2 文件共享，开机净省 ~40MB 物理内存
/etc/init.d/samba4 disable 2>/dev/null || true
/etc/init.d/wsdd2 disable 2>/dev/null || true

# 11. QWRT 精华调优移植：SSDP/WSD 组播免连接跟踪 (NOTRACK) 与 16MB 万兆 TCP 套接字大缓冲区
# 避免 UPnP/WSD 局域网广播进入 conntrack 跟踪，杜绝交换芯片 CDM 队列丢包告警
uci -q batch <<EOF
set firewall.upnp_ssdp_notrack=rule
set firewall.upnp_ssdp_notrack.name='UPnP SSDP multicast discovery'
set firewall.upnp_ssdp_notrack.src='lan'
set firewall.upnp_ssdp_notrack.family='ipv4'
set firewall.upnp_ssdp_notrack.proto='udp'
set firewall.upnp_ssdp_notrack.dest_ip='239.255.255.250'
set firewall.upnp_ssdp_notrack.dest_port='1900'
set firewall.upnp_ssdp_notrack.target='NOTRACK'

set firewall.wsd_ipv4_notrack=rule
set firewall.wsd_ipv4_notrack.name='WSD IPv4 multicast discovery'
set firewall.wsd_ipv4_notrack.src='lan'
set firewall.wsd_ipv4_notrack.family='ipv4'
set firewall.wsd_ipv4_notrack.proto='udp'
set firewall.wsd_ipv4_notrack.dest_ip='239.255.255.250'
set firewall.wsd_ipv4_notrack.dest_port='3702'
set firewall.wsd_ipv4_notrack.target='NOTRACK'

set firewall.wsd_ipv6_notrack=rule
set firewall.wsd_ipv6_notrack.name='WSD IPv6 multicast discovery'
set firewall.wsd_ipv6_notrack.src='lan'
set firewall.wsd_ipv6_notrack.family='ipv6'
set firewall.wsd_ipv6_notrack.proto='udp'
set firewall.wsd_ipv6_notrack.dest_ip='ff02::c'
set firewall.wsd_ipv6_notrack.dest_port='3702'
set firewall.wsd_ipv6_notrack.target='NOTRACK'
commit firewall
EOF

# 扩大 TCP 读写套接字缓冲区至 16MB 并扩容网络队列，消除万兆大带宽长肥管道瓶颈与软中断突发丢包
mkdir -p /etc/sysctl.d
cat <<'EOF' > /etc/sysctl.d/30-network-buffers.conf
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
net.core.netdev_max_backlog=16384
net.core.netdev_budget=600
net.core.dev_weight=128
EOF
sysctl -p /etc/sysctl.d/30-network-buffers.conf 2>/dev/null || true

# 约束多核 CPU 本地空闲页缓存上限至 1/128，防止内存碎片与多核内存饥饿
cat <<'EOF' > /etc/sysctl.d/20-airoha-memory.conf
vm.percpu_pagelist_high_fraction=128
EOF
sysctl -p /etc/sysctl.d/20-airoha-memory.conf 2>/dev/null || true

# 12. 预置中国标准时间 (Asia/Shanghai / CST-8) 与完整 NTP 校时
uci -q batch <<EOF
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
commit system
EOF
/etc/init.d/system reload 2>/dev/null || true

exit 0
